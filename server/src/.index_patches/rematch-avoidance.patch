+    f.id !== fixture.id &&
+    f.divisionId === fixture.divisionId &&
+    f.bracketRole === fixture.bracketRole &&
+    f.round === fixture.round &&
+    f.status !== 'completed' &&
+    f[slotField] === targetSlot &&
